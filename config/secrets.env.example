# CloudAI Fusion Secret Configuration Example
# Copy this file to secrets.env and fill in actual values
# NEVER commit the filled version to version control

# API Keys
DATABASE_URL=postgresql://user:password@localhost:5432/cloudai_fusion
REDIS_URL=redis://localhost:6379/0

# JWT Secrets (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=your-jwt-secret-key-here-minimum-32-characters
JWT_REFRESH_SECRET_KEY=your-jwt-refresh-secret-key-here-minimum-32-characters

# Service-to-service authentication
INTERNAL_API_KEY=your-internal-api-key-here

# External Service Credentials
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
PROMETHEUS_BASIC_AUTH_USERNAME=prometheus
PROMETHEUS_BASIC_AUTH_PASSWORD=prometheus-password

# Tracing & Monitoring
JAGERG_ENDPOINT=http://jaeger-all-in-one:14268/api/traces
DATADOG_API_KEY=your-datadog-api-key-if-used

# Security Keys (minimum 32 characters recommended)
ENCRYPTION_KEY_1=super-long-random-string-minimum-32-chars
ENCRYPTION_KEY_2=another-super-long-random-string-minimum-32

# AI Engine Specific
MODEL_REGISTRY_URL=http://model-registry:8080
ML_SECURITY_API_KEY=ml-security-api-key-here

# Feature Flags (toggle features)
FEATURE_FLAG_M47_TRACING=true
FEATURE_FLAG_M29_M31_API=true
FEATURE_FLAG_M49_CHAOS=true
FEATURE_FLAG_M9_METRICS=true

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS_PER_MINUTE=500
RATE_LIMIT_WINDOW_SECONDS=60

# Circuit Breaker Settings
CIRCUIT_BREAKER_THRESHOLD_PERCENTAGE=50
CIRCUIT_BREAKER_TIMEOUT_SECONDS=60

# Disaster Recovery
BACKUP_S3_BUCKET=cloudai-fusion-backups
BACKUP_AWS_ACCESS_KEY_ID=your-aws-access-key
BACKUP_AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# K8s Ingress SSL (if using HTTPS)
SSL_CERT_PATH=/etc/ssl/certs/ingress.crt
SSL_KEY_PATH=/etc/ssl/private/ingress.key
