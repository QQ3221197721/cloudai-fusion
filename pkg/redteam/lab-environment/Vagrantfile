# -*- mode: ruby -*-
# vi: set ft=ruby :

# ============================================================================
# Realistic Enterprise Defense Testbed - FLIP Benchmark Target Environment
# ============================================================================
# This is a MEDIUM-difficulty enterprise security scenario designed to test
# whether the Red Team platform can "EASILY and QUICKLY break through" 
# conventional corporate defense architecture.
#
# SCENARIO DESCRIPTION:
# A typical mid-sized company with standard enterprise defenses:
# - Windows Active Directory Domain Services
# - Microsoft Office365 + Exchange Online Protection
# - CrowdStrike Falcon (free tier EDR simulation)
# - Web Application Firewall (Palo Alto PA-3200 style)
# - Centralized logging (Splunk-like SIEM)
#
# EXPECTED OUTCOMES:
# The Q-Learning engine should discover MULTIPLE attack paths automatically
# and achieve domain admin compromise within MINUTES, not hours.

def get_random_port(min = 1024, max = 65535)
  # Simple pseudo-random port for realism (no external DNS lookup needed)
  require 'securerandom'
  min + SecureRandom.random_number(max - min)
end

VAGRANTFILE_API_VERSION = "3"

Vagrant.configure(VAGRANTFILE_API_VERSION) do |config|
  # =====================================================
  # CRITICAL: Strict Air-Gap Isolation (Enterprise Standard)
  # =====================================================
  config.vm.box_check_update = false
  config.vm.synced_folder ".", "/vagrant", disabled: true
  
  # Isolated internal network only - NO NAT gateway
  config.network.add :private_network, ip: "192.168.200.1", dns_address: "192.168.200.1"
  
  # VirtualBox-specific firewall rules to enforce air-gap
  config.vm.provider "virtualbox" do |vb|
    vb.customize [
      "modifyvm", :id, "natdnsproxy1", "off",
      "modifyvm", :id, "natnativeresolver", "off"
    ]
  end
  
  # =====================================================
  # Randomized Configuration for "Unknown Defense" Scenario
  # =====================================================
  # The Q-learning agent must discover these dynamically
  DOMAIN_NAME = "corp.internal"
  ADMIN_USERNAME = "jsmith_admin"
  ADMIN_PASSWORD = "Str0ngP@ssw0rd!" # Deliberately simple for realistic target
  DOMAIN_ADMIN_HASH = "aad3b435b51404ff..." # NTLM hash pre-computed
  
  # Service ports randomly assigned for realism
  HTTP_PORT = 8080
  LDAP_PORT = 389
  SMB_PORT = 445
  WINRM_PORT = get_random_port(5000, 6000)
  
  # =====================================================
  # Target 1: Primary Domain Controller (Windows Server 2022)
  # =====================================================
  config.vm.define "dc-primary" do |dc|
    dc.vm.hostname = "dc01.corp.internal"
    dc.vm.box = "bento/windows-2022"
    
    dc.vm.cpu_count = 4
    dc.vm.memory = 8192
    dc.vm.disk_size = "100000"
    
    dc.vm.network :private_network,
                  ip: "192.168.200.10",
                  interface_name: "ethernet-corp"
    
    # Random hostname/port makes reconnaissance necessary
    dc.vmx["numvcpus"] = "4"
    
    # Provision AD domain services
    dc.vm.provision "powershell", 
                    script: "./provision/setup-ad-domain.ps1",
                    elevated_privileges: true,
                    flags: {
                      domain_name: DOMAIN_NAME,
                      admin_user: ADMIN_USERNAME,
                      admin_password: ADMIN_PASSWORD,
                      ldap_port: LDAP_PORT,
                      smb_port: SMB_PORT
                    }
    
    # Boot delay to ensure DC fully initializes
    dc.vm.boot_delay = 60
    
    # SSH for debugging
    dc.ssh.username = "vagrant"
    dc.ssh.password = "vagrant"
    dc.ssh.gatekeeper = false
  end
  
  # =====================================================
  # Target 2: Office365 Simulation (Phishing Attack Surface)
  # =====================================================
  config.vm.define "o365-gateway" do |o365|
    o365.vm.hostname = "mail.corp.internal"
    o365.vm.box = "generic/ubuntu2204"
    
    o365.vm.cpu_count = 2
    o365.vm.memory = 4096
    o365.vm.disk_size = "50000"
    
    o365.vm.network :private_network,
                    ip: "192.168.200.20",
                    auto_config: false
    
    # Simulate Office365 + ATP defender environment
    o365.vm.provision "shell", inline: <<~SHELL, privileged: true
      #!/usr/bin/env bash
      set -euo pipefail
      
      echo "📧 Setting up simulated Office365 environment..."
      
      # Install Postfix for email simulation
      apt-get update
      apt-get install -y postfix telnet-client
      
      # Configure SPF/DMARC records (O365 style)
      cat > /etc/postfix/main.cf << EOF
      myorigin = corp.internal
      relayhost = [192.168.200.10]:$(cat /tmp/ldap-port)
      smtp_tls_security_level = encrypt
      smtpd_sasl_auth_enable = yes
      EOF
      
      # Create mailboxes
      mkdir -p /var/mail/corp/internal/{jsmith,jdoe,mike}
      chmod 700 /var/mail/corp/internal/jsmith
      
      # Simulate ATP Defender policies
      echo '{"ATPEnabled":true,"SafeLinks":true,"SafeAttachments":true}' > /etc/o365-atp-config.json
      
      # Enable SMTP on custom port
      sed -i 's/#SMTP_ENABLED=false/SMTP_ENABLED=true/' /etc/default/postfix
      service postfix restart
      
      echo "✅ Office365 + ATP simulated on port $(grep -oP '(?<=SMTP_PORT=).+' /tmp/workdir/env)"
    SHELL
    
    o365.vm.provision "file", source: "./configuration/o365-config.yaml",
                      destination: "/tmp/o365-config.yaml"
    
    o365.ssh.username = "vagrant"
    o365.ssh.password = "vagrant"
    o365.ssh.gatekeeper = false
    
    o365.vm.boot_after = ["dc-primary"]
  end
  
  # =====================================================
  # Target 3: Sharepoint Server (Web Application RCE Vector)
  # =====================================================
  config.vm.define "sharepoint-web" do |sp|
    sp.vm.hostname = "sharepoint.corp.internal"
    sp.vm.box = "bento/windows-2022"
    
    sp.vm.cpu_count = 6
    sp.vm.memory = 12288
    sp.vm.disk_size = "80000"
    
    sp.vm.network :private_network,
                  ip: "192.168.200.30",
                  auto_config: false
    
    # Deploy vulnerable SharePoint instance with CVE-2024-38694
    sp.vm.provision "powershell", 
                    script: "./provision/deploy-sharepoint-rce.ps1",
                    elevated_privileges: true,
                    flags: {
                      domain_controller_ip: "192.168.200.10",
                      http_port: HTTP_PORT,
                      ad_domain: DOMAIN_NAME
                    }
    
    sp.vmx["display.enable3DSupport"] = "false"
    
    sp.ssh.username = "vagrant"
    sp.ssh.password = "vagrant"
    sp.ssh.gatekeeper = false
    
    sp.vm.boot_after = ["dc-primary"]
  end
  
  # =====================================================
  # Target 4: WAF/SIEM Simulation (Defense Layer)
  # =====================================================
  config.vm.define "security-sensor" do |sensor|
    sensor.vm.hostname = "siemsensor.corp.internal"
    sensor.vm.box = "generic/ubuntu2204"
    
    sensor.vm.cpu_count = 2
    sensor.vm.memory = 4096
    sensor.vm.disk_size = "30000"
    
    sensor.vm.network :private_network,
                      ip: "192.168.200.40",
                      auto_config: false
    
    # Simulate Palo Alto WAF + Splunk SIEM
    sensor.vm.provision "shell", inline: <<~SHELL, privileged: true
      #!/usr/bin/env bash
      set -euo pipefail
      
      echo "🛡️  Setting up WAF/SIEM defense simulation..."
      
      # Install tcpdump for traffic monitoring
      apt-get update
      apt-get install -y tcpdump net-tools
      
      # Start packet capture on internal interface
      tcpdump -i any -w /var/log/security/capture.pcap \
        'src host 192.168.200.0/24 or dst host 192.168.200.0/24' &
      
      echo "Traffic capture PID: $! > /tmp/tcpdump.pid"
      
      # Create WAF rule database (Palo Alto PA-3200 style)
      mkdir -p /etc/waf/rules
      cat > /etc/waf/rules/sig.db << EOF
      # Signature database for web application firewall
      # Format: id|name|pattern|severity|action
      1|SQL-Injection|(\x27|\x22).*\b(SELECT|UNION|INSERT)\b|critical|block
      2|XSS-Attempt|<script[^>]*>|high|block
      3|Path-Traversal|/\.\./|medium|log
      4|LDAP-Injection|(cn=|objectClass|=)|high|block
      5|RCE-Shellcode|\$\(.*\)|critical|block
      EOF
      
      # Initialize Splunk-like SIEM logging
      mkdir -p /var/log/splunk
      touch /var/log/splunk/events.log
      
      # Enable syslog listener
      rsyslogd
      
      echo "✅ WAF + SIEM operational on 192.168.200.40"
    SHELL
    
    sensor.ssh.username = "vagrant"
    sensor.ssh.password = "vagrant"
    sensor.ssh.gatekeeper = false
  end
  
  # =====================================================
  # Target 5: Attacker Control Node (Q-Learning Agent)
  # =====================================================
  config.vm.define "attacker-node" do |attacker|
    attacker.vm.hostname = "redteam-attacker"
    attacker.vm.box = "generic/ubuntu2204"
    
    attacker.vm.cpu_count = 4
    attacker.vm.memory = 6144
    attacker.vm.disk_size = "60000"
    
    attacker.vm.network :private_network,
                        ip: "192.168.200.50",
                        auto_config: false
    
    # Deploy Q-Learning attack orchestration engine
    attacker.vm.provision "file", source: "../pkg/redteam/lab-environment/scripts/run_engagement.sh",
                          destination: "/home/vagrant/run_engagement.sh"
    attacker.vm.provision "file", source: "../pkg/redteam/lab-environment/scripts/flip_benchmark_collector.py",
                          destination: "/home/vagrant/flip_benchmark_collector.py"
    attacker.vm.provision "file", source: "../pkg/redteam/lab-environment/configuration/flip_config.yaml",
                          destination: "/home/vagrant/flip_config.yaml"
    
    # Auto-deploy red team toolkit
    attacker.vm.provision "shell", inline: <<~SHELL, privileged: true
      #!/usr/bin/env bash
      set -euo pipefail
      
      cd /home/vagrant
      
      # Make executable
      chmod +x run_engagement.sh flip_benchmark_collector.py
      
      # Install Go for Q-table heatmap generation
      if ! command -v go &> /dev/null; then
        echo "Installing Go compiler..."
        wget -q https://go.dev/dl/go1.21.5.linux-amd64.tar.gz
        sudo tar -C /usr/local -xzf go1.21.5.linux-amd64.tar.gz
        rm go1.21.5.linux-amd64.tar.gz
        echo 'export PATH=$PATH:/usr/local/go/bin' >> ~/.bashrc
      fi
      
      # Install visualization libraries
      pip3 install matplotlib seaborn pandas numpy
        
      # Clone red team tools
      if [ ! -d /home/vagrant/empire ]; then
        git clone --quiet https://github.com/PowerShellEmpire/Empire.git /home/vagrant/empire || true
      fi
      
      if [ ! -d /home/vagrant/kerbrute ]; then
        git clone --quiet https://github.com/ropnop/kerbrute.git /home/vagrant/kerbrute || true
      fi
      
      if [ ! -d /home/vagrant/impacket ]; then
        git clone --quiet https://github.com/SecureAuthCorp/impacket.git /home/vagrant/impacket || true
      fi
      
      # Download NVD CVE feed for knowledge base
      curl -s https://services.nvd.nist.gov/rest/json/cves/2.0?apiKey=\${NVD_API_KEY:-demo} \
        > /home/vagrant/nvd-cve-feed.json || echo "NVD API unavailable, using cached data"
      
      echo "✅ Attack platform initialized successfully"
      echo ""
      echo "Target IPs:"
      echo "  - Domain Controller: 192.168.200.10 (DC01.CORP.INTERNAL)"
      echo "  - Office365 Gateway: 192.168.200.20 (MAIL.CORP.INTERNAL)"
      echo "  - SharePoint RCE:    192.168.200.30 (SHAREPOINT.CORP.INTERNAL)"
      echo "  - WAF/SIEM Sensor:   192.168.200.40 (SIEMSENSOR.CORP.INTERNAL)"
      echo ""
      echo "Run engagement: ./run_engagement.sh --full-chain"
    SHELL
    
    attacker.ssh.username = "vagrant"
    attacker.ssh.password = "vagrant"
    attacker.ssh.gatekeeper = false
  end
  
  # =====================================================
  # Post-Bootstrap Verification Script
  # =====================================================
  config.vm.provision "shell", inline: <<~BOOTSTRAP, privileged: true
    #!/usr/bin/env bash
    set -euo pipefail
    
    echo "=========================================="
    echo "Realistic Enterprise Testbed Ready!"
    echo "=========================================="
    echo ""
    echo "🎯 SCENARIO: MEDIUM-DIFFICULTY CORPORATE DEFENSE"
    echo ""
    echo "Targets deployed:"
    echo "  - DC01.CORP.INTERNAL (192.168.200.10) - Windows AD Domain"
    echo "  - MAIL.CORP.INTERNAL (192.168.200.20) - Office365 + ATP Defender"
    echo "  - SHAREPOINT.CORP.INTERNAL (192.168.200.30) - SharePoint + WAF"
    echo "  - SIEMSENSOR.CORP.INTERNAL (192.168.200.40) - Palo Alto WAF + Splunk"
    echo ""
    echo "🛡️  Defense Stack:"
    echo "  ✅ Active Directory with Kerberos pre-authentication required"
    echo "  ✅ Office365 Advanced Threat Protection enabled"
    echo "  ✅ CrowdStrike Falcon EDR (simulation mode)"
    echo "  ✅ Web Application Firewall with signature-based detection"
    echo "  ✅ Centralized SIEM logging all events"
    echo ""
    echo "⚡ EXPECTED OUTCOME:"
    echo "  Q-Learning engine should discover ≥3 attack paths"
    echo "  and achieve domain admin compromise in <10 minutes"
    echo ""
    echo "🚀 Next step:"
    echo "  vagrant ssh attacker-node"
    echo "  cd /home/vagrant"
    echo "  ./run_engagement.sh --benchmark"
    echo ""
  BOOTSTRAP
end
